{
  "name": "agent-code-reviewer",
  "version": "1.0.0",
  "description": "Review code changes with Claude — locally via the claude CLI, or as a GitHub Action on PRs",
  "main": "dist/index.js",
  "bin": {
    "review": "bin/review.mjs"
  },
  "scripts": {
    "review": "node bin/review.mjs",
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm run build"
  },
  "keywords": [
    "github-action",
    "code-review",
    "claude",
    "anthropic",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.102.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.0"
  }
}
